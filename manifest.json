{
  "manifest_version": 3,
  "name": "Twitch Chat Messages Highlighting",
  "version": "2.1.1",
  "description": "Highlight users messages on Twitch.",
  "icons": {
    "16": "public/favicons/icon16.png",
    "48": "public/favicons/icon48.png",
    "128": "public/favicons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://m.twitch.tv/*",
        "https://dashboard.twitch.tv/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-chat-highlighter@vgtom4",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
